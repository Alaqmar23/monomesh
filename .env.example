# Sparse3D Environment Configuration

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

DATABASE_URL=sqlite:///storage/sparse3d.db

UPLOAD_DIR=storage/uploads
MODEL_DIR=storage/models
RECONSTRUCTION_DIR=storage/reconstructions
EXPERIMENT_DIR=storage/experiments
TEMP_DIR=storage/temp

MAX_UPLOAD_SIZE_MB=100

# Device: 'auto', 'cuda', 'cpu'
DEVICE=auto

# Engine: 'auto', 'classical', 'vggt'
RECONSTRUCTION_ENGINE=auto

# Generative refinement model toggles (Require >= 8GB VRAM)
ENABLE_VGGT=true
ENABLE_HUNYUAN=false
ENABLE_TRELLIS=false
